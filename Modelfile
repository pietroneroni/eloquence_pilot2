FROM mistral-small3.1:24b

# Contesto: 32k è un buon compromesso per RAG + storia breve.
# Il modello supporta contesti lunghi, ma aumentare num_ctx costa RAM/VRAM.
PARAMETER num_ctx 32768

# Output massimo: abbastanza per risposta visibile + LISTENER_PATCH,
# ma non così alto da favorire divagazioni.
PARAMETER num_predict 1200

# Bassa temperatura = più coerenza, meno fantasia/allucinazioni.
PARAMETER temperature 0.15

# Sampling conservativo ma non troppo rigido.
PARAMETER top_p 0.90
PARAMETER top_k 40
PARAMETER min_p 0.05

# Riduce loop/ripetizioni senza rendere il modello troppo "secco".
PARAMETER repeat_penalty 1.08

# Applica la penalità di ripetizione su tutto il contesto disponibile.
PARAMETER repeat_last_n -1

# Utile per esperimenti riproducibili, se il backend lo rispetta.
PARAMETER seed 42